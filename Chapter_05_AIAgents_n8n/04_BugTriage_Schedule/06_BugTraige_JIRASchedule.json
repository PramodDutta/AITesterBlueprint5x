    {
      "parameters": {
        "promptType": "define",
        "text": "=Issue Key : {{ $json.key }}\n\nTitle : {{ $json.fields.summary }}\n\nDescription  : {{ $json.fields.description }}",
        "options": {
          "systemMessage": "based on the Issue Key, Title and Description give me the \n\nResponse as json with keys\n\n{\n  \"severity\" : \"\",\n  \"priority\" : \"\",\n  \"comments\" : \"\"\n}\n\nin the comments add the gaps you think,\n\nMake sure the comments are simple, don't add anything like /n and more, normal text string without special chars"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        320,
        -112
      ],
      "id": "778350d9-5833-466e-bc1b-c6f1ddaf3d1d",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://bugzz.atlassian.net/rest/api/3/issue/{{ $('Edit Fields').item.json.issueKey }}/comment",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "jiraSoftwareCloudApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"body\": {\n    \"type\": \"doc\",\n    \"version\": 1,\n    \"content\": [\n      {\n        \"type\": \"paragraph\",\n        \"content\": [\n          {\n            \"type\": \"text\",\n            \"text\": \"{{ $json.Comments }}\"\n          }\n        ]\n      }\n    ]\n  }\n} ",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
